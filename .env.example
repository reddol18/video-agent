# ─── Gemini API ───────────────────────────────────────────
# Google AI Studio (https://aistudio.google.com) 에서 발급
GOOGLE_API_KEY=여기에_Gemini_API_키_붙여넣기

# ─── Google Cloud TTS ─────────────────────────────────────
# Google Cloud 서비스 계정 JSON 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=./gcp_key.json

# ─── Gemini 호출 속도 제한 설정 ────────────────────────────
# 무료 티어(15 RPM): 4 / 유료 티어: 1 또는 0
GEMINI_REQUEST_INTERVAL_SEC=4
# #355 후속: 무료 티어 일시 429에 견디기 위해 5회. 백오프는 _MAX_BACKOFF_SEC 으로 상한 캡.
GEMINI_MAX_RETRY=5
# #355 후속: 지수 백오프 상한(초). 10*2^attempt 가 끝없이 커지는 것을 막음.
GEMINI_MAX_BACKOFF_SEC=60
# #355 후속: footage 인덱싱 시 호출 사이 고정 sleep(초). 분당 호출 수 제한용.
# 2026-06-05 재조정: 4 → 10. Tier 1 RPM 한도는 충분하지만 호출당 영상 토큰(~17K)이 커서
# TPM 한도가 진짜 병목으로 추정됨. 분당 6회로 묶어 ~106K TPM 안전선 확보.
GEMINI_INDEX_RPM_INTERVAL_SEC=10

# ─── Gemini 영상 트랜스코딩(인덱싱 전용) ───────────────────
# 영상 1개당 토큰/처리 비용 절감용 압축 파라미터. 비워두면 코드 기본값 사용.
# GEMINI_TRANSCODE_HEIGHT=360      # 360p 권장 (Gemini Vision 최소)
# GEMINI_TRANSCODE_BITRATE=200k
# GEMINI_TRANSCODE_FPS=2           # 2026-06-05 재조정: 5 → 2 (TPM 한도 보호)
# GEMINI_TRANSCODE_AUDIO_BITRATE=32k

# ─── TTS 설정 ──────────────────────────────────────────────
TTS_VOICE_NAME=ko-KR-Chirp3-HD-Orus
TTS_SPEAKING_RATE=1.0

# ─── 파이프라인 설정 ───────────────────────────────────────
CHUNK_DURATION_SEC=10
CHUNK_OVERLAP_SEC=2
MIN_QUALITY_SCORE=0.5

# ─── 미리보기 하드웨어 가속 (#361) ────────────────────────
# 켜면 백엔드 ffmpeg 미리보기 생성에 macOS VideoToolbox 디코더/인코더를 사용한다.
# macOS Apple Silicon 환경에서 미리보기 생성을 2~5x 빠르게 한다.
# Phase 6 최종 렌더링(src/clip_editor.py)에는 영향을 주지 않는다 (미리보기 한정).
# 비활성(기본): libx264 CPU 인코더. Linux/Windows는 사용 가능 시에만 활성화.
# VIDEO_AGENT_HWACCEL=1

# ─── 비가시 워터마크 (렌더 옵션, 기본 끔) ─────────────────
# PyTorch·Video Seal 은 프로젝트 venv 가 아닌 별도 환경에 설치한다(src/watermark.py 참고).
# 비워두면 저장소 두 단계 위의 wm-lab/ 폴더(.venv, videoseal clone)를 찾는다.
# WATERMARK_PYTHON=<wm-lab 경로>/.venv/Scripts/python.exe
# VIDEOSEAL_DIR=<wm-lab 경로>/videoseal
# 페이로드로 넣을 제작자 ID (SHA-256 → 256비트). 기본 "video-agent".
# WATERMARK_CREATOR_ID=video-agent
# 모델: pixelseal(기본, 슬라이드형 화면에 강함) | videoseal. 검증할 때도 같은 모델을 써야 한다.
# WATERMARK_MODEL=pixelseal

# ─── 슬랙 알림 ─────────────────────────────────────────────
# Bot User OAuth Token (xoxb-로 시작)
# Slack 앱 생성: agents/slack_app_manifest.yml 참고
SLACK_BOT_TOKEN=xoxb-여기에_봇_토큰_붙여넣기
# 본인 슬랙 User ID (U로 시작, 프로필 URL에서 확인)
SLACK_USER_ID=U여기에_유저ID_붙여넣기
